<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= folder.name %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include("partials/navbar", { isGuest: !currentUser }) %>
  <main id="folder-content-container">
    <h1><%= folder.name %></h1>

    <form method="post" action="/folders/<%= folder.id %>/share">
      <button type="submit">Share folder</button>
    </form>

    <form
      action="/folders/<%= folder.id %>/files"
      method="POST"
      enctype="multipart/form-data"
    >
      <label for="file">Choose a file:</label>

      <input
        id="file"
        type="file"
        name="file"
        required
      >

      <button type="submit">Upload file</button>
    </form>

    <% if (files && files.length > 0) { %>
      <h2>Files</h2>

      <div class="file-grid">
        <% files.forEach((file) => { %>
          <div class="file-card">
            <a
              href="/uploads/<%= file.storageKey %>"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src="/uploads/<%= file.storageKey %>"
                alt="<%= file.name %>"
              >
            </a>

            <div class="file-card__body">
              <p><%= file.name %></p>

              <% if (file.size) { %>
                <small>
                  (<%= (file.size / 1024).toFixed(1) %> KB)
                </small>
              <% } %>

              <form method="post" action="/uploads/<%= file.id %>/delete">
                <button type="submit" class="danger">Remove</button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="empty-state">No files uploaded yet.</p>
    <% } %>
  </main>
</body>
</html>
